# Copie este archivo como .env y cambie los valores (el .env real no se sube a GitHub).

# Dirección de la API de DropX (dropx_web), sin "/" al final:
# - Emulador de Android: http://10.0.2.2:5000
# - Celular real: http://IP-DE-LA-COMPUTADORA:5000 (ej: http://192.168.1.10:5000)
API_URL=http://10.0.2.2:5000

# Segundos máximos de espera de una respuesta de la API
API_TIMEOUT_SECONDS=15
